{
  "name": "mercadofacil",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Mercado Fácil - Folheto digital de ofertas e localização de mercados",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed:backend": "npm --prefix backend run seed",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test": "npm run test:backend && npm run test:frontend",
    "ai:status": "node scripts/local-ai-manager.mjs status",
    "ai:tasks": "node scripts/local-ai-manager.mjs tasks",
    "ai:generate": "node scripts/local-ai-manager.mjs generate --all",
    "ai:features:tasks": "node scripts/local-ai-manager.mjs --file tarefas-funcionalidades.json tasks",
    "ai:features:generate": "node scripts/local-ai-manager.mjs --file tarefas-funcionalidades.json generate --all --concurrency 2"
  }
}
